# Copy to .env.local — never commit secrets.

# Public canonical URL (optional in dev; set on Vercel for production)
NEXT_PUBLIC_SITE_URL=https://launchlitestudio.com

# --- Quote form (server-only — do NOT prefix with NEXT_PUBLIC) ---
# Where notifications are delivered (not shown on the website).
CONTACT_FORM_RECIPIENT=your-inbox@example.com

# From https://resend.com after signup
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Defaults to Resend test sender:
#   LaunchLite Studio <onboarding@resend.dev>
# After you verify launchlitestudio.com in Resend, set e.g.:
# EMAIL_FROM="LaunchLite Studio <contact@launchlitestudio.com>"
# EMAIL_FROM=
