# Copy to .env.local — never commit secrets.

# Public canonical URL (optional in dev; set on Vercel for production)
NEXT_PUBLIC_SITE_URL=https://launchlitestudio.com

# Optional — paste from Google Business Profile → Share (short maps link).
# NEXT_PUBLIC_GOOGLE_BUSINESS_URL=https://g.page/your-profile

# Optional structured-data locality (suburb/city label shown publicly — no street address published).
# NEXT_PUBLIC_BUSINESS_SUBURB=Western Sydney
#
# Optional public phone surfaced on structured data when provided (never invent).
# NEXT_PUBLIC_BUSINESS_PHONE=

# Optional Google Search Console HTML tag verification token (injected into site-wide metadata when set).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional GA4 + Microsoft Clarity (loaded via Next Script only when configured).
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_CLARITY_PROJECT_ID=xxxxxxxxxx

# --- Quote form (server-only — do NOT prefix with NEXT_PUBLIC) ---
# Where notifications are delivered (not shown on the website).
CONTACT_FORM_RECIPIENT=your-inbox@example.com

# From https://resend.com after signup (use one line — prefer LAUNCHLITE_* if
# Windows has an empty RESEND_API_KEY set globally; it overrides .env.local).
LAUNCHLITE_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional "From" address (must match a verified domain in Resend).
# Until DNS is verified, omit EMAIL_FROM to use Resend's test sender (or sends fail).
# EMAIL_FROM="LaunchLite Studio <contact@launchlitestudio.com>"
